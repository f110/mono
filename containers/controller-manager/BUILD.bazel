load("@rules_oci//oci:defs.bzl", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//build/rules/artifact:def.bzl", "cd_artifact")
load("//build/rules/container:def.bzl", "container_image")

REPOSITORY = "repo.center.x.f110.dev/tools/controller-manager"

pkg_tar(
    name = "bin",
    files = {
        "//go/cmd/controller-manager:linux_amd64": "/usr/local/bin/controller-manager",
    },
    mode = "0755",
)

container_image(
    name = "image",
    base = "@com_google_distroless_base_linux_amd64",
    entrypoint = ["/usr/local/bin/controller-manager"],
    tars = [":bin"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = REPOSITORY,
)

cd_artifact(
    name = "delivery",
    images = [":image"],
    repository = REPOSITORY,
)
