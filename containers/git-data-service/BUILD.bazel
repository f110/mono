load("@rules_oci//oci:defs.bzl", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//build/rules/artifact:def.bzl", "cd_artifact")
load("//build/rules/container:def.bzl", "container_image")

REPOSITORY = "repo.center.x.f110.dev/repo-doc/git-data-service"

pkg_tar(
    name = "bin",
    files = {
        "//go/cmd/git-data-service:linux_amd64": "/usr/local/bin/git-data-service",
        "@protoc_ddl//cmd/migrate:linux_amd64": "/usr/local/bin/migrate",
    },
    mode = "0755",
)

pkg_tar(
    name = "schema_files",
    srcs = ["//go/git/database:schema_txt"],
    mode = "0644",
    package_dir = "/schema",
)

container_image(
    name = "image",
    base = "@com_google_distroless_base_linux_amd64",
    entrypoint = ["/usr/local/bin/git-data-service"],
    tars = [
        ":bin",
        ":schema_files",
    ],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = REPOSITORY,
)

cd_artifact(
    name = "delivery",
    images = [":image"],
    repository = REPOSITORY,
)
