load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "mcp.go",
        "pullrequest.go",
        "repository.go",
        "review.go",
        "server.go",
    ],
    importpath = "go.f110.dev/mono/go/codexel/server",
    visibility = ["//visibility:public"],
    deps = [
        "//go/claudecode",
        "//go/codexel/api",
        "//go/codexel/config",
        "//go/codexel/pullrequest",
        "//go/codexel/review",
        "//go/git",
        "//go/github",
        "//go/herdr",
        "//go/jujutsu",
        "//go/logger",
        "@com_connectrpc_connect//:connect",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_go_enry_go_enry_v2//:go-enry",
        "@com_github_google_go_github_v85//github",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@dev_f110_go_xerrors//:xerrors",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "server_test",
    srcs = [
        "pullrequest_test.go",
        "repository_test.go",
        "review_test.go",
        "server_test.go",
    ],
    args = [
        "-test.jj-binary=../../../$(location @jj//:bin)",
    ],
    data = [
        "@jj//:bin",
    ],
    embed = [":server"],
    deps = [
        "//go/codexel/api",
        "//go/codexel/config",
        "//go/codexel/pullrequest",
        "//go/codexel/review",
        "//go/herdr",
        "//go/jujutsu",
        "//go/logger",
        "//go/testing/assertion",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_go_github_v85//github",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@dev_f110_go_githubmock//:githubmock",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)
