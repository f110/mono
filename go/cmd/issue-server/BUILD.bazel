load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")

go_library(
    name = "issue-server_lib",
    srcs = ["main.go"],
    importpath = "go.f110.dev/mono/go/cmd/issue-server",
    visibility = ["//visibility:private"],
    deps = [
        "//go/build/api",
        "//go/cli",
        "//go/git",
        "//go/github",
        "//go/http/authproxy",
        "//go/issue",
        "//go/issue/database",
        "//go/issue/database/dao",
        "//go/issue/server",
        "//go/issue/webhook",
        "//go/logger/slogger",
        "@com_github_go_sql_driver_mysql//:mysql",
        "@dev_f110_go_xerrors//:xerrors",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@protoc_ddl//probe",
    ],
)

go_binary(
    name = "issue-server",
    embed = [":issue-server_lib"],
    visibility = ["//visibility:public"],
)

go_cross_binary(
    name = "linux_amd64",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":issue-server",
    visibility = ["//visibility:public"],
)
